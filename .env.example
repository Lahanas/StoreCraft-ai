# --- Sanity (https://www.sanity.io/manage) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
# Editor token: used by the seed script and the Stripe webhook to write orders + stock
SANITY_API_WRITE_TOKEN=sk_your_sanity_write_token

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AI assistant (Vercel AI Gateway: https://vercel.com/ai-gateway) ---
AI_GATEWAY_API_KEY=your_ai_gateway_key
# Any gateway model id, e.g. anthropic/claude-sonnet-5.5, openai/gpt-5, google/gemini-3-flash
AI_MODEL=anthropic/claude-sonnet-5.5

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
